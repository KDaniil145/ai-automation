    {
      "parameters": {
        "jsCode": "\nconst data = $input.first().json.body ?? {}\n\nfunction invalid(message) {\n  return [{\n    json: {\n      valid: false,\n      error: {\n        code: \"VALIDATION_ERROR\",\n        message\n      }\n    }\n  }]\n}\n\nconst { action, weight, priority } = data\n\nif (![\"calculate\", \"save\"].includes(action)) {\n  return invalid(\"Неизвестное действие\")\n}\n\nif (typeof weight !== \"number\" ||\n    !Number.isFinite(weight) || weight <= 0) {\n  return invalid(\"Вес должен быть положительным числом\")\n}\n\nif (typeof priority !== \"boolean\") {\n  return invalid(\"Приоритет должен быть true или false\")\n}\n\nconst category = weight > 10\n  ? \"heavy\"\n  : priority ? \"express\" : \"standard\"\n\nif (action === \"calculate\") {\n  return [{\n    json: {\n      valid: true,\n      action,\n      category\n    }\n  }]\n}\n\nconst { name, shippingDate } = data\n\nif (typeof name !== \"string\" ||\n    !name.trim() || name.trim().length > 80) {\n  return invalid(\"Название должно содержать от 1 до 80 символов\")\n}\n\nif (typeof shippingDate !== \"string\" ||\n    !/^\\d{4}-\\d{2}-\\d{2}$/.test(shippingDate) ||\n    !Number.isFinite(Date.parse(shippingDate)) ||\n    new Date(shippingDate).toISOString().slice(0, 10) !== shippingDate) {\n  return invalid(\"Некорректная дата отправки\")\n}\n\nreturn [{\n  json: {\n    valid: true,\n    action,\n    parcel: {\n      name: name.trim(),\n      weight,\n      priority,\n      category,\n      shippingDate\n    }\n  }\n}]\n"
      },
