    {
      "parameters": {
        "jsCode": "\nconst parcels = $input.all()\n  .map(item => item.json)\n  .filter(row => row.id != null)\n  .map(row => ({\n    id: row.id,\n    name: row.name,\n    weight: row.weight,\n    priority: row.priority,\n    category: row.category,\n    shippingDate: row.shipping_date\n  }))\n\nreturn [{\n  json: {\n    parcels\n  }\n}]\n"
      },
